# ===== 桥接服务 =====
BRIDGE_PORT=8787

# ===== 企业微信（后台获取）=====
WECOM_CORP_ID=ww0000000000000000
WECOM_AGENT_ID=1000002
WECOM_APP_SECRET=your_app_secret
WECOM_TOKEN=your_callback_token
WECOM_ENCODING_AES_KEY=your_43_char_encoding_aes_key
# 成员 userid（通讯录里查看）
WECOM_TOUSER=your_userid

# ===== Claude =====
CLAUDE_BIN=/home/user\USER\.local\bin\claude.exe
# Windows 上 claude 需要 git-bash 路径（否则无法运行）
CLAUDE_CODE_GIT_BASH_PATH=D:\devtools\git\Git\bin\bash.exe
# 默认工作目录（多项目注册表里会按项目覆盖）
WORKDIR=/path\projects\PROJECT
SESSION_DIR=/home/user\USER\.claude\projects
# 权限模式: default(微信确认) 或 bypassPermissions(完全信任，不推荐)
CLAUDE_PERMISSION_MODE=default
# MCP 权限确认服务的端口（claude 通过 stdio 连接，此处仅为内部管理）
APPROVER_PORT=8790
# 权限确认超时（毫秒），默认5分钟
APPROVER_TIMEOUT_MS=300000

# ===== 注册表 =====
REGISTRY_FILE=/home/user\USER\.claude\wecom-bridge\sessions.json

# ===== SSH 反向隧道 =====
ENABLE_TUNNEL=0
SSH_REMOTE_USER=wecomtunnel
SSH_SERVER=your-server.example.com
SSH_KEY=/home/user\USER\.ssh\id_ed25519
SSH_REMOTE_PORT=9000

# ===== 云转发（出站推送走云服务器，源IP=云IP，解决可信IP校验）=====
# 1 开启 / 0 关闭
SEND_VIA_CLOUD=0
# 云服务器上的转发端点
SEND_CLOUD_ENDPOINT=https://your-domain.com/wecom/send
# 与云服务器转发服务约定的鉴权密钥
BRIDGE_SECRET=your_bridge_secret

# ===== 智能机器人（API模式-长连接，对话流式默认通道，免公网IP白名单）=====
# 1 开启 / 0 关闭（未配置则纯自建应用模式）
WECOM_BOT_ENABLED=0
# 企业微信后台「智能机器人 → API模式创建 → 长连接」获取
WECOM_BOT_ID=your_bot_id
WECOM_BOT_SECRET=your_bot_secret
WECOM_BOT_WS=wss://openws.work.weixin.qq.com
# 流式分片间隔（毫秒）与超时兜底
WECOM_BOT_STREAM_INTERVAL_MS=800
WECOM_BOT_STREAM_IDLE_TIMEOUT_MS=15000
WECOM_BOT_STREAM_TOTAL_TIMEOUT_MS=120000


